# All variables are optional; defaults are shown. Set them in Vercel → Project → Settings → Environment Variables.

# --- Backend (Python) ---
BINANCE_FAPI_URL=https://fapi.binance.com
HTTP_TIMEOUT_S=10
HTTP_MAX_RETRIES=2
# Max parallel requests to Binance per invocation
MAX_CONCURRENCY=20
# Top-N symbols by 24h volume scanned for RSI / MA cross / volume / anomaly (2 weight each, limit 2400/min)
SCANNER_UNIVERSE_SIZE=400
# Top-N symbols for open interest (openInterestHist limit: 1000 requests / 5 min)
OI_UNIVERSE_SIZE=150
# Binance Alpha (Web3 tokens, /web3 pages). Undocumented binance.com web API, so it is scanned gently.
BINANCE_ALPHA_URL=https://www.binance.com
# Top-N Alpha tokens by 24h volume
ALPHA_UNIVERSE_SIZE=150
# Max parallel requests to Binance Alpha per invocation
ALPHA_MAX_CONCURRENCY=8
# Comma-separated origins, only needed if the frontend is hosted on a different domain
CORS_ORIGINS=

# --- Frontend (Vite, build time) ---
# Only needed if the API is on a different origin
VITE_API_BASE_URL=
